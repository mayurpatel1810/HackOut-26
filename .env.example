# ---------------------------------------------------------------------------
# EcoForge AI - copy to .env and fill in. NOTHING here has a working default:
# the services refuse to start with a missing or placeholder secret.
# ---------------------------------------------------------------------------

# Database
POSTGRES_DB=${ecoforge_db}
POSTGRES_USER=${postgres}
POSTGRES_PASSWORD=${PASSWORD}            # required - choose a strong password
POSTGRES_PORT=${5432}

# Shared secret for the Spring Boot -> FastAPI hop. Any random 32+ char string.
#   openssl rand -hex 32
ECOFORGE_SERVICE_TOKEN=${96dd64f9ea45e849f4d76e37870590d1e23180c9514be26afd3e24c1b5006321}

# JWT signing key for the browser session. Must be at least 32 characters.
#   openssl rand -hex 32
JWT_SECRET=${96dd64f9ea45e849f4d76e37870590d1e23180c9514be26afd3e24c1b5006321}

# Ports
BACKEND_PORT=${8081}
FRONTEND_PORT=${5173}
AI_PORT=${8001}
CORS_ORIGINS=${http://localhost:5173}

# Seed the demo factory on first start (operational inputs only - every
# emission, cost and scenario value is still calculated at runtime).
SEED_DEMO=${true}

# ---------------------------------------------------------------------------
# Language model - OPTIONAL. EcoForge is fully functional without it: the
# Copilot answers from the deterministic engines instead. The model may only
# explain what the engines produced; it is never a source of numbers.
# ---------------------------------------------------------------------------
ECOFORGE_LLM_PROVIDER=${ECOFORGE_LLM_PROVIDER}
ECOFORGE_LLM_API_KEY=${ECOFORGE_LLM_API_KEY}
ECOFORGE_LLM_MODEL=${ECOFORGE_LLM_MODEL}
ECOFORGE_LLM_BASE_URL=${ECOFORGE_LLM_BASE_URL}
